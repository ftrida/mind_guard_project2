# Production Environment Configuration for Render / Cloud Host (MySQL)

# Port (Render sets process.env.PORT automatically to 10000)
PORT=10000

# MySQL Connection String (from Aiven / TiDB / Railway / PlanetScale / Clever Cloud)
# Format: mysql://user:password@host:port/dbname
MYSQL_URL=mysql://user:password@mysql-host.cloud.com:3306/mindguard
MYSQL_SSL=true

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_64_character_hex_secret
JWT_EXPIRES_IN=7d

# Allowed Frontend URL(s) for CORS (No trailing slash)
CLIENT_URL=https://your-username.github.io

# Resend API key for emergency email notifications
RESEND_API_KEY=re_123456789...

# Admin emergency alerts destination email
ADMIN_EMAIL=emergency-alerts@mindguard.com

# Node Environment
NODE_ENV=production
